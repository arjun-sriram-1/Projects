# Copy this file to .env and fill in your secrets.

APP_ENV=development
APP_DEBUG=True
APP_SECRET_KEY=YOUR_SECRET_KEY

PYTHONPATH=.

DB_URL=postgresql://postgres:your_password@localhost:5432/fuel_risk_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=fuel_risk_db
POSTGRES_PORT=5432

EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store/faiss_index
FAISS_INDEX_PATH=./data/vector_store/faiss.index
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=

RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

EIA_API_KEY=YOUR_EIA_API_KEY
FRED_API_KEY=YOUR_FRED_API_KEY
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY
YAHOO_DISABLE_CACHE=False

ENABLE_OIL_FORECASTS=True
ENABLE_RAG_ASSISTANT=True
DEFAULT_TIMEZONE=UTC

LOCAL_STORAGE_PATH=./data/local
LOG_LEVEL=INFO
